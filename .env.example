# App
NODE_ENV=development
APP_URL=http://localhost:3000
# Secret Auth.js (min 32 chars)
AUTH_SECRET=change-me-to-a-long-random-secret-string
AUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://smartcommerce:smartcommerce@localhost:5432/smartcommerce?schema=public

# Redis (sessions cache + BullMQ)
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Paiements (Phase 3) — agrégateurs modulaires
# mock | stripe | flutterwave | paystack | maxicash | flexpay
# Jamais de succès faux sans confirmation provider / webhook.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Stripe sandbox (cartes USD/EUR) — optionnel
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave sandbox (cartes + Mobile Money USD/CDF) — optionnel, KYC prod
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=

# Paystack sandbox (cartes + MM selon pays) — optionnel, KYC prod
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Maxicash / FlexPay (RDC) — contrat + clés requis ; sans clés = unavailable
# MAXICASH_API_KEY=
# FLEXPAY_API_KEY=

# AI providers — fail-closed if missing (no fake success)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Phase 6 — crédits Studio + TTS/rendu vidéo (hooks fail-closed)
AI_CREDITS_LIMIT=500
ELEVENLABS_API_KEY=
VIDEO_RENDER_API_KEY=

# Object storage (MinIO local / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=smartcommerce
S3_FORCE_PATH_STYLE=true

# Encryption for social tokens (AES-GCM, 32-byte hex or base64)
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Demo seed (optional)
SEED_DEMO_EMAIL=demo@smartcommerce.ai
SEED_DEMO_PASSWORD=Demo1234!

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Phase 4)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER=auto
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=smartcommerce-wa-verify
WHATSAPP_WEBHOOK_SECRET=dev-wa-webhook-secret-change-me
WHATSAPP_DEFAULT_STORE_ID=

# ---------------------------------------------------------------------------
# Meta / TikTok Social (Phase 5)
# Sans clés: OAuth/publish/Ads = unavailable (pas de faux succès)
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
# Optionnels après OAuth / Business Manager
META_PAGE_ID=
META_CATALOG_ID=
META_AD_ACCOUNT_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# true uniquement si le compte est éligible Ads API
TIKTOK_ADS_ELIGIBLE=false
