generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  disabled
}

enum OrgStatus {
  active
  suspended
}

enum MemberStatus {
  invited
  active
  revoked
}

enum RoleScope {
  platform
  organization
  store
}

enum StoreStatus {
  draft
  live
  archived
}

enum ProductStatus {
  draft
  active
  archived
}

enum VariantStatus {
  active
  disabled
}

enum CartStatus {
  open
  converted
  abandoned
}

enum OrderStatus {
  pending
  awaiting_payment
  cod_pending
  paid
  fulfilled
  cancelled
  refunded
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum FulfillmentStatus {
  unfulfilled
  partial
  fulfilled
}

enum PaymentMethod {
  card
  mobile_money
  bank
  cash_on_delivery
  other
}

enum RefundStatus {
  pending
  succeeded
  failed
}

enum PaymentRecordStatus {
  requires_action
  pending
  succeeded
  failed
  cancelled
}

enum CampaignChannel {
  meta
  tiktok
  whatsapp
  organic
}

enum CampaignStatus {
  draft
  scheduled
  active
  paused
  completed
  failed
}

enum CreativeType {
  text
  image
  carousel
  video
  banner
}

enum CreativeStatus {
  draft
  ready
  approved
  published
  rejected
}

enum AIJobType {
  ad_copy
  ad_image
  product_description
  ad_copy_pack
  ad_visual
  ad_video_script
  ad_ab_variants
}

enum AdStrategy {
  sales
  acquisition
  brand
}

enum AIJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum PlanInterval {
  month
  year
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

enum SocialProvider {
  whatsapp
  meta
  tiktok
}

enum SocialConnectionStatus {
  connected
  expired
  revoked
  needs_approval
}

enum SocialPostStatus {
  draft
  scheduled
  publishing
  published
  failed
  unavailable
  needs_approval
}

enum CatalogSyncStatus {
  pending
  exported
  synced
  failed
  unavailable
}

enum AttributionSource {
  meta
  tiktok
  whatsapp
  organic
  direct
  other
}

enum ConversationChannel {
  whatsapp
  instagram
  tiktok
  email
  web
}

enum ConversationStatus {
  open
  pending
  human_handoff
  closed
}

enum MessageDirection {
  inbound
  outbound
  system
}

enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
  unavailable
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  emailVerified      DateTime?
  passwordHash       String?
  name               String?
  imageUrl           String?
  locale             String    @default("fr")
  preferredCurrency  String    @default("USD")
  status             UserStatus @default(active)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  organizationMembers OrganizationMember[]
  storeMembers       StoreMember[]
  createdCampaigns   MarketingCampaign[] @relation("CampaignCreator")
  createdAIJobs      AIJob[] @relation("AIJobCreator")
  notifications      Notification[]
  auditLogs          AuditLog[] @relation("AuditActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  country         String     @default("CD")
  defaultCurrency String     @default("USD")
  defaultLocale   String     @default("fr")
  status          OrgStatus  @default(active)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  members         OrganizationMember[]
  stores          Store[]
  subscriptions   Subscription[]
  aiUsage         AIUsage[]
  aiJobs          AIJob[]
  invoices        Invoice[]
  notifications   Notification[]
  auditLogs       AuditLog[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Store {
  id                  String      @id @default(cuid())
  organizationId      String
  name                String
  slug                String
  description         String?
  logoKey             String?
  timezone            String      @default("Africa/Kinshasa")
  currency            String      @default("USD")
  supportedCurrencies String[]    @default(["USD", "CDF", "EUR"])
  locales             String[]    @default(["fr", "en"])
  status              StoreStatus @default(draft)
  settings            Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      StoreMember[]
  categories   Category[]
  products     Product[]
  variants     ProductVariant[]
  inventories  Inventory[]
  customers    Customer[]
  carts        Cart[]
  orders       Order[]
  orderItems   OrderItem[]
  payments     Payment[]
  refunds      Refund[]
  campaigns    MarketingCampaign[]
  creatives    AdCreative[]
  aiJobs       AIJob[]
  socialConnections SocialConnection[]
  socialPosts  SocialPost[]
  catalogExports CatalogExport[]
  attributionEvents AttributionEvent[]
  conversations Conversation[]
  messages     Message[]
  notifications Notification[]
  auditLogs    AuditLog[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([slug])
}

model StoreMember {
  id          String       @id @default(cuid())
  storeId     String
  userId      String
  roleId      String
  invitedById String?
  status      MemberStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id])

  @@unique([storeId, userId])
  @@index([userId])
  @@index([storeId, roleId])
}

model Role {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  scope       RoleScope
  permissions String[]
  isSystem    Boolean   @default(true)

  organizationMembers OrganizationMember[]
  storeMembers        StoreMember[]
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  parentId  String?
  name      Json
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, parentId])
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  categoryId  String?
  name        Json
  description Json?
  slug        String
  status      ProductStatus @default(draft)
  media       Json?
  attributes  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, categoryId])
}

model ProductVariant {
  id              String        @id @default(cuid())
  productId       String
  storeId         String
  sku             String
  name            Json?
  options         Json?
  priceAmount     Decimal       @db.Decimal(18, 0)
  currency        String
  compareAtAmount Decimal?      @db.Decimal(18, 0)
  weightGrams     Int?
  status          VariantStatus @default(active)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([storeId, sku])
  @@index([productId])
  @@index([storeId])
}

model Inventory {
  id                String   @id @default(cuid())
  storeId           String
  variantId         String   @unique
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  lowStockThreshold Int?
  updatedAt         DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model Customer {
  id                      String    @id @default(cuid())
  storeId                 String
  userId                  String?
  email                   String?
  phone                   String?
  name                    String?
  locale                  String?
  tags                    String[]  @default([])
  metadata                Json?
  /// Explicit opt-in for WhatsApp marketing / abandoned-cart nudges
  marketingConsentWhatsApp Boolean  @default(false)
  marketingConsentAt      DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  carts         Cart[]
  orders        Order[]
  conversations Conversation[]

  @@index([storeId, phone])
  @@index([storeId, userId])
  @@index([storeId, email])
}

model Cart {
  id                  String     @id @default(cuid())
  storeId             String
  customerId          String?
  sessionId           String?
  currency            String
  status              CartStatus @default(open)
  expiresAt           DateTime?
  abandonedNudgeSentAt DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@index([storeId, sessionId])
  @@index([storeId, customerId])
  @@index([status, expiresAt])
  @@index([status, abandonedNudgeSentAt])
}

model Conversation {
  id               String             @id @default(cuid())
  storeId          String
  customerId       String?
  channel          ConversationChannel @default(whatsapp)
  externalThreadId String?
  status           ConversationStatus @default(open)
  assignedToUserId String?
  aiEnabled        Boolean            @default(true)
  lastMessageAt    DateTime?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  messages Message[]

  @@unique([storeId, channel, externalThreadId])
  @@index([storeId, status, lastMessageAt])
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String
  storeId           String
  direction         MessageDirection
  body              String
  media             Json?
  externalMessageId String?
  status            MessageStatus    @default(queued)
  sentByUserId      String?
  error             String?
  createdAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([storeId, externalMessageId])
}

model CartItem {
  id               String  @id @default(cuid())
  cartId           String
  variantId        String
  quantity         Int
  unitPriceAmount  Decimal @db.Decimal(18, 0)
  currency         String

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id                 String            @id @default(cuid())
  storeId            String
  customerId         String?
  orderNumber        String
  status             OrderStatus       @default(pending)
  paymentStatus      PaymentStatus     @default(unpaid)
  fulfillmentStatus  FulfillmentStatus @default(unfulfilled)
  currency           String
  subtotalAmount     Decimal           @db.Decimal(18, 0)
  shippingAmount     Decimal           @default(0) @db.Decimal(18, 0)
  taxAmount          Decimal           @default(0) @db.Decimal(18, 0)
  discountAmount     Decimal           @default(0) @db.Decimal(18, 0)
  totalAmount        Decimal           @db.Decimal(18, 0)
  shippingAddress    Json?
  billingAddress     Json?
  notes              String?
  placedAt           DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  storeId         String
  variantId       String?
  productName     Json
  sku             String
  quantity        Int
  unitPriceAmount Decimal @db.Decimal(18, 0)
  currency        String
  totalAmount     Decimal @db.Decimal(18, 0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([storeId, variantId])
}

model Payment {
  id             String              @id @default(cuid())
  storeId        String
  orderId        String
  provider       String
  providerRef    String?
  idempotencyKey String              @unique
  method         PaymentMethod       @default(other)
  /// Mobile Money operator when method=mobile_money: mpesa | airtel_money | orange_money
  operator       String?
  status         PaymentRecordStatus @default(pending)
  amount         Decimal             @db.Decimal(18, 0)
  currency       String
  rawPayload     Json?
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([storeId, orderId])
  @@index([provider, providerRef])
  @@index([storeId, createdAt])
}

model Refund {
  id          String       @id @default(cuid())
  storeId     String
  paymentId   String
  orderId     String
  providerRef String?
  amount      Decimal      @db.Decimal(18, 0)
  currency    String
  reason      String?
  status      RefundStatus @default(pending)
  rawPayload  Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([storeId, orderId])
}

model Plan {
  id          String       @id @default(cuid())
  code        String       @unique
  name        Json
  priceAmount Decimal      @db.Decimal(18, 0)
  currency    String
  interval    PlanInterval @default(month)
  limits      Json
  isActive    Boolean      @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String
  planId                 String
  status                 SubscriptionStatus @default(trialing)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  invoices     Invoice[]

  @@index([organizationId])
  @@index([status, currentPeriodEnd])
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  subscriptionId String?
  number         String   @unique
  amount         Decimal  @db.Decimal(18, 0)
  currency       String
  status         String   @default("draft")
  pdfKey         String?
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId, status])
}

model MarketingCampaign {
  id                 String          @id @default(cuid())
  storeId            String
  name               String
  channel            CampaignChannel @default(organic)
  status             CampaignStatus  @default(draft)
  budgetAmount       Decimal?        @db.Decimal(18, 0)
  currency           String?
  schedule           Json?
  externalCampaignId String?
  /// Explicit merchant confirmation required before any paid spend/publish
  spendConfirmedAt   DateTime?
  spendConfirmedById String?
  performance        Json?
  error              String?
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("CampaignCreator", fields: [createdById], references: [id])
  creatives AdCreative[]

  @@index([storeId, status])
  @@index([storeId, channel])
}

model SocialPost {
  id               String           @id @default(cuid())
  storeId          String
  provider         SocialProvider
  caption          String?
  mediaUrls        Json?
  hashtags         String[]         @default([])
  script           String?
  scheduledAt      DateTime?
  status           SocialPostStatus @default(draft)
  externalPostId   String?
  error            String?
  metadata         Json?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, provider, status])
  @@index([storeId, scheduledAt])
}

model CatalogExport {
  id             String            @id @default(cuid())
  storeId        String
  provider       SocialProvider
  status         CatalogSyncStatus @default(pending)
  itemCount      Int               @default(0)
  exportPayload  Json?
  externalRef    String?
  error          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, provider, createdAt])
}

model AttributionEvent {
  id         String            @id @default(cuid())
  storeId    String
  source     AttributionSource
  medium     String?
  campaign   String?
  content    String?
  term       String?
  clickId    String?
  sessionId  String?
  orderId    String?
  path       String?
  metadata   Json?
  createdAt  DateTime          @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, source, createdAt])
  @@index([storeId, orderId])
  @@index([storeId, sessionId])
}

model AdCreative {
  id           String         @id @default(cuid())
  storeId      String
  campaignId   String?
  type         CreativeType
  locale       String
  headline     String?
  body         String?
  cta          String?
  assetKey     String?
  aiJobId      String?
  status       CreativeStatus @default(draft)
  strategy     AdStrategy?
  /// e.g. ig_feed_1x1, ig_story_9x16, fb_feed, wa_status, tiktok_9x16, banner_16x9
  format       String?
  variantGroup String?
  variantLabel String?
  hashtags     String[]       @default([])
  overlays     Json?
  productId    String?
  metadata     Json?
  approvedAt   DateTime?
  approvedById String?
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign MarketingCampaign? @relation(fields: [campaignId], references: [id])
  aiJob    AIJob?             @relation(fields: [aiJobId], references: [id])

  @@index([storeId, campaignId])
  @@index([aiJobId])
  @@index([storeId, status])
  @@index([storeId, variantGroup])
}

model AIJob {
  id             String      @id @default(cuid())
  organizationId String
  storeId        String
  type           AIJobType
  status         AIJobStatus @default(queued)
  provider       String
  input          Json
  output         Json?
  error          String?
  usageTokens    Int?
  costMinor      Decimal?    @db.Decimal(18, 0)
  createdById    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("AIJobCreator", fields: [createdById], references: [id])
  creatives    AdCreative[]

  @@index([storeId, status])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model AIUsage {
  id             String   @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  tokensUsed     Int      @default(0)
  imageCount     Int      @default(0)
  videoCount     Int      @default(0)
  creditsUsed    Int      @default(0)
  creditsLimit   Int      @default(500)
  costMinor      Decimal  @default(0) @db.Decimal(18, 0)
  currency       String   @default("USD")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart])
}

model SocialConnection {
  id                   String                 @id @default(cuid())
  storeId              String
  provider             SocialProvider
  accountLabel         String?
  externalAccountId    String
  encryptedCredentials String
  scopes               String[]               @default([])
  status               SocialConnectionStatus @default(needs_approval)
  metadata             Json?
  connectedAt          DateTime?
  expiresAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider, externalAccountId])
}

model Notification {
  id             String   @id @default(cuid())
  storeId        String?
  organizationId String?
  userId         String
  type           String
  title          Json
  body           Json
  channel        String   @default("in_app")
  status         String   @default("pending")
  payload        Json?
  createdAt      DateTime @default(now())
  readAt         DateTime?

  store        Store?        @relation(fields: [storeId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([storeId, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  storeId        String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  ip             String?
  userAgent      String?
  diff           Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  store        Store?        @relation(fields: [storeId], references: [id])
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
}

model WebhookEvent {
  id           String   @id @default(cuid())
  provider     String
  eventKey     String
  payload      Json
  processedAt  DateTime?
  createdAt    DateTime @default(now())

  @@unique([provider, eventKey])
  @@index([createdAt])
}
